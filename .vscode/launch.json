{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        // One configuration per relabelling strategy (cascade / deep / gmm /
        // mano); GMM/MANO/Deep are pointed at P7's "Trial 1 Hands only"
        // recording, Cascade at P10's (both "Trial 1 Hands only") -- change
        // --participant/--trial per config to point at a different trial.
        // The python interpreter is the repo's own Windows venv
        // (.viconvenv\Scripts\python.exe) -- the previous entries below
        // pointed at a Linux path from another machine (/home/codex/...)
        // and at pre-reorganisation script locations
        // (scripts/train_labeler.py); both are fixed here.

        {
            "name": "Strategy: Cascade (quality cascade)",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/cascade/run_quality_cascade.py",
            "python": "${workspaceFolder}/.viconvenv/Scripts/python.exe",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                // No --csv: quality_cascade.main() now resolves the trial
                // CSV from --participant/--trial via manual_frames.csv
                // (find_trial_csv) when neither --csv nor --c3d is given --
                // the same lookup gmm/mano's relabel_trial.py scripts use.
                "--ref-csv",
                "D:/ExperimentsJune25/manual_frames.csv",
                // --out omitted too: defaults to
                // results/cascade/{participant}_{trial}_quality_cascade.csv
                "--participant",
                "P10",
                "--trial",
                "Trial 1 Hands only"
            ]
        },
        {
            "name": "Strategy: Deep (deep_labeler eval)",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/deep/eval_labeler.py",
            "python": "${workspaceFolder}/.viconvenv/Scripts/python.exe",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                // deep_labeler has no --participant/--trial flags -- the
                // trial is named by the CSV path itself (this is P7's
                // "Trial 1 Hands only" recording, matching GMM/MANO below;
                // Cascade above is currently pointed at P10 instead).
                "--weights",
                "vicon2mano/weights/deep_labeler.pt",
                "--real-data",
                "D:/ExperimentsJune25/P7/P7/Trial1_handsonly.csv",
                "--out-dir",
                "vicon2mano/eval/deep_labeler"
            ]
        },
        {
            "name": "Strategy: GMM (relabel_trial)",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/gmm/relabel_trial.py",
            "python": "${workspaceFolder}/.viconvenv/Scripts/python.exe",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "--participant",
                "P7",
                "--trial",
                "Trial 1 Hands only"
            ]
        },
        {
            "name": "Strategy: MANO (relabel_trial)",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/mano/relabel_trial.py",
            "python": "${workspaceFolder}/.viconvenv/Scripts/python.exe",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "--participant",
                "P7",
                "--trial",
                "Trial 1 Hands only",
                "--side",
                "right"
            ]
        },

        // --- pre-existing configs, fixed to the Windows venv and the
        // post-reorganisation script paths (scripts/deep/...) ---

        {
            "name": "Python: Train Labeler",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/deep/train_labeler.py",
            "python": "${workspaceFolder}/.viconvenv/Scripts/python.exe",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "train",
                "--real-data",
                "data/Pxh8/Hands_only_Left/trajectories_synced.csv",
                "--out-weights",
                "vicon2mano/weights/deep_labeler.pt",
                "--epochs",
                "20",
                "--batch-size",
                "16",
                "--num-workers",
                "4",
                "--max-samples",
                "500"
            ]
        },
        // [train] done.  Best val loss: 0.01332  Weights → vicon2mano/weights/deep_labeler.pt
        {
            "name": "Python: Eval Labeler",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/deep/eval_labeler.py",
            "python": "${workspaceFolder}/.viconvenv/Scripts/python.exe",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "--weights",
                "vicon2mano/weights/deep_labeler.pt",
                "--real-data",
                "data/Pxh8/Hands_only_Left/trajectories_synced.csv",
                "--mano-dir",
                "../clean_kinematics/mano_v1_2/models",
                "--out-dir",
                "vicon2mano/eval/deep_labeler"
            ]
        }
    ]
}
